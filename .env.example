# =============================================================================
# TALENT-MATCHER — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca comite o .env.local no repositório.
#
# ATENÇÃO: NÃO use o prefixo NEXT_PUBLIC_ para chaves de API secretas.
# Variáveis com NEXT_PUBLIC_ são embutidas no bundle JavaScript do browser
# e ficam visíveis para qualquer pessoa que inspecionar o código-fonte.
# Todas as chamadas ao Gemini são feitas exclusivamente no servidor (API Routes).
# =============================================================================

# --- Gemini API (obrigatório) -------------------------------------------------
# Chave principal. Usada APENAS em API Routes (server-side).
GEMINI_API_KEY=sua_chave_gemini_aqui

# Chave alternativa opcional (fallback se a principal atingir rate limit).
# Também usada apenas server-side.
GEMINI_API_KEY_ALT=sua_chave_alternativa_aqui

# --- Ambiente ----------------------------------------------------------------
# Values: development | production | test
NODE_ENV=development

# --- Deploy na Vercel (apenas GitHub Secrets / CI-CD) ------------------------
# NUNCA coloque esses valores em arquivos .env — somente em GitHub Secrets.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
